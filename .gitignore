# Local backups
backups/

# Local theme selection
shell/theme/selection.json

# Logs and temporary files
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store

# Editor
.vscode/
.idea/

# Runtime files
*.pid

# Generated from Theme Bank by Amber Alacritty
config/alacritty/amber-colors.toml

# Local fish config snapshot; may contain private variables
config/fish/

/notes.tex
